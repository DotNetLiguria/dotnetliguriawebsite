<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <OutputType>Exe</OutputType>
    <!-- Keep dotnet run independent of the machine-wide Aspire CLI. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>dotnetliguria-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.6.4" />
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <ProjectReference Include="..\dotnetliguriawebsite\DotNetLiguriaCore\DotNetLiguriaCore.csproj" />
  </ItemGroup>
</Project>
