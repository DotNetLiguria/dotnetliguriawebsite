<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <UserSecretsId>f7de20b3-7c2d-4e15-8c51-4d51dfc9648a</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..\..</DockerfileContext>
        <DockerfileRunArguments>-p "5050:8080"</DockerfileRunArguments>
        <PublishSpa Condition="'$(PublishSpa)' == ''">true</PublishSpa>
        <SpaDistPath Condition="'$(SpaDistPath)' == ''">$(MSBuildProjectDirectory)/../../dotnetliguriaspa/dist</SpaDistPath>
        <!-- Disable browser link and refresh for SPA applications -->
        <DisableBrowserLink>true</DisableBrowserLink>
        <DisableBrowserRefresh>true</DisableBrowserRefresh>
    </PropertyGroup>

    <ItemGroup>
      <Content Update="appsettings.Development.json;secrets-template.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
        <PackageReference Include="MailKit" Version="4.18.2" />
        <PackageReference Include="NetEscapades.Extensions.Logging.RollingFile" Version="2.5.0" />
        <PackageReference Include="Markdig" Version="1.5.0" />
        <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\CommonAuth\CommonAuth.csproj" />
        <ProjectReference Include="..\CommonWeb\CommonWeb.csproj" />
        <ProjectReference Include="..\..\DotNetLiguria.ServiceDefaults\DotNetLiguria.ServiceDefaults.csproj" />
        <ProjectReference Include="..\DotNetLiguriaCore.Model\DotNetLiguriaCore.Model.csproj" />
    </ItemGroup>

      <Target Name="IncludePublishedSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSpa)' == 'true'">
        <Error Condition="!Exists('$(SpaDistPath)/index.html')" Text="Build the frontend with npm ci and npm run build in src/dotnetliguriaspa before publishing, or explicitly set PublishSpa=false for an API-only artifact." />
        <ItemGroup>
          <_SpaPublishFiles Include="$(SpaDistPath)/**/*" />
          <_SpaPublishFiles Update="@(_SpaPublishFiles)">
            <RelativePath>wwwroot/%(_SpaPublishFiles.RecursiveDir)%(_SpaPublishFiles.Filename)%(_SpaPublishFiles.Extension)</RelativePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
          </_SpaPublishFiles>
          <ResolvedFileToPublish Remove="@(_SpaPublishFiles)" MatchOnMetadata="RelativePath" MatchOnMetadataOptions="PathLike" />
          <ResolvedFileToPublish Include="@(_SpaPublishFiles)" />
        </ItemGroup>
      </Target>

</Project>
