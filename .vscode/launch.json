{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch DotNetLiguria (Aspire)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-aspire",
            "program": "${workspaceFolder}/src/DotNetLiguria.AppHost/bin/Debug/net10.0/DotNetLiguria.AppHost.dll",
            "cwd": "${workspaceFolder}/src/DotNetLiguria.AppHost",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:17230;http://localhost:15230",
                "ASPIRE_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21230",
                "ASPIRE_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22230"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Launch DataMigration (Manual - writes data)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-datamigration",
            "program": "${workspaceFolder}/src/dotnetliguriawebsite/DataMigration/bin/Debug/net10.0/DataMigration.dll",
            "cwd": "${workspaceFolder}/src/dotnetliguriawebsite/DataMigration",
            "console": "integratedTerminal",
            "env": { "DOTNET_ENVIRONMENT": "Development" }
        }
    ]
}
