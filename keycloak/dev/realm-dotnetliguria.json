{
  "realm": "DotNetLiguria",
  "displayName": "DotNetLiguria",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "loginTheme": "dotnetliguria",
  "internationalizationEnabled": true,
  "supportedLocales": ["it", "en"],
  "defaultLocale": "it",
  "roles": {
    "client": {
      "DotNetLiguriaCore": [
        { "name": "events.read" }, { "name": "events.manage" }, { "name": "events.publish" },
        { "name": "events.delete" }, { "name": "events.homepage.manage" }, { "name": "events.past.manage" },
        { "name": "event-assets.read" }, { "name": "event-assets.manage" }, { "name": "event-assets.delete" },
        { "name": "eventbrite.read" }, { "name": "eventbrite.manage" }, { "name": "eventbrite.publish" },
        { "name": "speakers.read" }, { "name": "speakers.manage" }, { "name": "speakers.delete" }, { "name": "speakers.merge" },
        { "name": "venues.read" }, { "name": "venues.manage" }, { "name": "venues.delete" },
        { "name": "board.read" }, { "name": "board.manage" }, { "name": "board.delete" },
        { "name": "site-menu.read" }, { "name": "site-menu.manage" }, { "name": "site-menu.delete" },
        { "name": "questionnaires.read" }, { "name": "questionnaires.manage" }, { "name": "questionnaires.publish" }, { "name": "questionnaires.delete" },
        { "name": "questionnaire-results.read" }, { "name": "questionnaire-responses.read" },
        { "name": "questionnaire-responses.export" }, { "name": "questionnaire-responses.delete" },
        { "name": "backups.read" }, { "name": "backups.create" }, { "name": "backups.restore" },
        { "name": "maintenance.counters.read" }, { "name": "maintenance.counters.manage" },
        { "name": "maintenance.speaker-references.repair" }, { "name": "maintenance.diagnostics.manage" },
        { "name": "privacy.operations.read" }, { "name": "privacy.operations.manage" }, { "name": "privacy.identities.read" },
        { "name": "privacy.notifications.retry" }, { "name": "privacy.retention.read" }, { "name": "privacy.retention.manage" },
        { "name": "notifications.preview" }, { "name": "notifications.confirm" },
        { "name": "access.users.read" }, { "name": "access.users.create" }, { "name": "access.permissions.grant" },
        { "name": "access.permissions.revoke" }, { "name": "access.audit.read" }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "dotnetliguria-permissions",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "application-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "DotNetLiguriaCore",
            "usermodel.clientRoleMapping.rolePrefix": "",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "DotNetLiguriaCore",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "DotNetLiguriaCore": [
      {
        "clientScope": "dotnetliguria-permissions",
        "roles": [
          "events.read", "events.manage", "events.publish", "events.delete", "events.homepage.manage", "events.past.manage",
          "event-assets.read", "event-assets.manage", "event-assets.delete",
          "eventbrite.read", "eventbrite.manage", "eventbrite.publish",
          "speakers.read", "speakers.manage", "speakers.delete", "speakers.merge",
          "venues.read", "venues.manage", "venues.delete", "board.read", "board.manage", "board.delete",
          "site-menu.read", "site-menu.manage", "site-menu.delete",
          "questionnaires.read", "questionnaires.manage", "questionnaires.publish", "questionnaires.delete",
          "questionnaire-results.read", "questionnaire-responses.read", "questionnaire-responses.export", "questionnaire-responses.delete",
          "backups.read", "backups.create", "backups.restore",
          "maintenance.counters.read", "maintenance.counters.manage", "maintenance.speaker-references.repair", "maintenance.diagnostics.manage",
          "privacy.operations.read", "privacy.operations.manage", "privacy.identities.read", "privacy.notifications.retry",
          "privacy.retention.read", "privacy.retention.manage", "notifications.preview", "notifications.confirm",
          "access.users.read", "access.users.create", "access.permissions.grant", "access.permissions.revoke", "access.audit.read"
        ]
      }
    ]
  },
  "groups": [
    { "name": "Board members", "clientRoles": { "DotNetLiguriaCore": ["events.read", "event-assets.read", "speakers.read", "venues.read", "board.read", "site-menu.read", "questionnaires.read", "questionnaire-results.read"] } },
    { "name": "Event editors", "clientRoles": { "DotNetLiguriaCore": ["events.read", "events.manage", "speakers.read", "venues.read"] } },
    { "name": "Event publishers", "clientRoles": { "DotNetLiguriaCore": ["events.read", "events.publish", "events.homepage.manage"] } },
    { "name": "Questionnaire designers", "clientRoles": { "DotNetLiguriaCore": ["events.read", "questionnaires.read", "questionnaires.manage"] } },
    { "name": "Feedback analysts", "clientRoles": { "DotNetLiguriaCore": ["events.read", "questionnaires.read", "questionnaire-results.read"] } }
  ],
  "clients": [
    {
      "clientId": "DotNetLiguriaSpa",
      "name": "DotNetLiguria SPA (local test)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "dotnetliguria-permissions"],
      "baseUrl": "https://localhost:5443/",
      "redirectUris": ["https://localhost:5443/*", "https://localhost:3443/*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "DotNetLiguriaCore",
      "name": "DotNetLiguria API audience (local fixture)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "dotnetliguria-permission-admin",
      "name": "Permission administration (configure minimum provider roles separately)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles"]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "local-test-not-a-real-client-id",
        "clientSecret": "local-test-not-a-real-secret",
        "syncMode": "IMPORT"
      }
    }
  ]
}
